{
    "name": "polytypo/polytypo",
    "description": "Normalize typography across languages: quotes, dashes, ellipses, apostrophes, symbols and no-break spaces.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://polytypo.dev/",
    "keywords": ["typography", "i18n", "l10n", "unicode", "quotes", "normalize-typography"],
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "giorgiosironi/eris": "^1.1",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Polytypo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polytypo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
